diff --git a/.github/workflows/build-apk.yml b/.github/workflows/build-apk.yml
new file mode 100644
index 0000000..9e115be
--- /dev/null
+++ b/.github/workflows/build-apk.yml
@@ -0,0 +1,51 @@
+name: Build APK
+
+on:
+  push:
+    branches: [large-dictionaries]
+  workflow_dispatch:
+
+jobs:
+  build:
+    runs-on: ubuntu-latest
+    timeout-minutes: 90
+    steps:
+      - name: Check out (shallow)
+        uses: actions/checkout@v4
+        with:
+          fetch-depth: 1
+          submodules: false
+
+      - name: Check out submodules (shallow, with LFS)
+        run: |
+          git lfs install
+          git submodule sync --recursive
+          git submodule update --init --recursive --depth 1 --jobs 4
+
+      - name: Set up JDK 17
+        uses: actions/setup-java@v4
+        with:
+          distribution: temurin
+          java-version: '17'
+
+      - name: Install Android NDK and CMake
+        run: |
+          yes | "$ANDROID_HOME/cmdline-tools/latest/bin/sdkmanager" --licenses > /dev/null || true
+          "$ANDROID_HOME/cmdline-tools/latest/bin/sdkmanager" --install "ndk;28.2.13676358" "cmake;3.22.1" > /dev/null
+
+      - name: Set up Gradle
+        uses: gradle/actions/setup-gradle@v4
+
+      - name: Build unstable release APK
+        env:
+          VERSION_NAME: large-dict-${{ github.run_number }}
+          VERSION_CODE: ${{ github.run_number }}
+          BRANCH_NAME: ${{ github.ref_name }}
+        run: ./gradlew assembleUnstableRelease --no-daemon -s
+
+      - name: Upload APK
+        uses: actions/upload-artifact@v4
+        with:
+          name: futo-keyboard-large-dict-${{ github.run_number }}
+          path: build/outputs/apk/unstable/release/*.apk
+          if-no-files-found: error
